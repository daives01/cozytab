{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "ignorePatterns": [
        "dist/**",
        "convex/_generated/**",
        "**/node_modules/**",
        "**/.wrangler/**",
        "docs/research/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/vendor/**",
        ".agents/**",
        ".codex/**",
        "**/.cache/**",
        "**/*.tsbuildinfo",
        "public/**",
        "**/assets/**"
    ],
    "jsPlugins": ["./vendor/anti-slop/src/index.ts"],
    "categories": {
        "correctness": "off"
    },
    "rules": {
        "anti-slop/require-readable-spacing": "error"
    }
}
