{
    "name": "cozytab",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        ".",
        "presence-worker"
    ],
    "type": "module",
    "scripts": {
        "web": "bunx vite",
        "convex": "bunx convex dev",
        "convex:deploy": "bunx convex deploy",
        "worker": "bun run --filter presence-worker dev",
        "worker:deploy": "bun run --filter presence-worker deploy",
        "all": "bunx concurrently \"bun run web --host\" \"bun run convex\" \"bun run worker --ip 0.0.0.0\"",
        "test": "bun test ./tests ./src",
        "build": "bunx tsc -b && bunx vite build",
        "lint": "bunx eslint .",
        "preview": "bunx vite preview",
        "prepare": "husky",
        "lint:ox": "oxlint .",
        "format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --write . && bun run format:spacing --fix && oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --write . && bun run format:spacing",
        "format:check": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --check . && bun run format:spacing",
        "check": "bun run format:check && bun run lint:ox && bun run lint && bun run typecheck:worker && bun run build && bun run test",
        "typecheck:worker": "bunx tsc --noEmit -p presence-worker/tsconfig.json",
        "lint:audit": "oxlint -c .oxlintrc.audit.json .",
        "format:spacing": "oxlint -c .oxlintrc.spacing.json ."
    },
    "dependencies": {
        "@clerk/clerk-react": "^5.61.3",
        "@convex-dev/stripe": "0.1.7",
        "@radix-ui/react-scroll-area": "^1.4.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@tailwindcss/vite": "^4.3.4",
        "chess.js": "^1.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "convex": "^1.49.0",
        "jotai": "^3.0.1",
        "lucide-react": "^1.70.0",
        "react": "^19.3.1",
        "react-chessboard": "^5.12.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5",
        "suncalc": "2.1.2",
        "tailwind-merge": "^3.7.0",
        "wrangler": "^4.158.0"
    },
    "devDependencies": {
        "@eslint/js": "^10",
        "@oxlint/plugins": "1.91.0",
        "@types/bun": "latest",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-test-renderer": "^19.3.1",
        "@vitejs/plugin-react": "^6",
        "concurrently": "^10",
        "convex-test": "0.0.67",
        "eslint": "^10",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5",
        "globals": "^17",
        "husky": "^9.1.7",
        "lint-staged": "^17",
        "oxfmt": "0.76.0",
        "oxlint": "1.91.0",
        "react-test-renderer": "^19.3.1",
        "stripe": "22.6.2",
        "tailwindcss": "^4.3.4",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8"
    },
    "lint-staged": {
        "**/*.{ts,tsx}": [
            "eslint --fix"
        ]
    },
    "packageManager": "bun@1.3.8"
}
