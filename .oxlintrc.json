{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "ignorePatterns": [
        "dist/**",
        "convex/_generated/**",
        "**/node_modules/**",
        "**/.wrangler/**",
        "docs/research/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/vendor/**",
        ".agents/**",
        ".codex/**",
        "**/.cache/**",
        "**/*.tsbuildinfo"
    ],
    "jsPlugins": ["./vendor/anti-slop/src/index.ts"],
    "rules": {
        "anti-slop/no-array-filter-map": "error",
        "anti-slop/no-reduce-accumulator-copy": "error",
        "oxc/no-accumulating-spread": "error"
    }
}
